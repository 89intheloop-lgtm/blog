---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { categories, siteConfig } from '../data/site';
import { projects } from '../data/projects';
import { getCategoryName } from '../utils/categories';
import { breadcrumbJsonLd, webPageJsonLd } from '../utils/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latest = posts.slice(0, 3);
const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);

const pageTitle = siteConfig.title;
const pageDescription = siteConfig.description;

const faqs = [
  {
    question: 'What is Build Log about?',
    answer:
      'Build Log is a personal technology blog by Saakshi Das covering AI tools, AI automation workflows, coding tutorials, and beginner-friendly web development. The focus is practical projects you can actually ship.',
  },
  {
    question: 'Who are these tutorials for?',
    answer:
      'The articles are written for beginners, students, freelancers, and developers who want clear explanations of AI tools and automation without unnecessary jargon.',
  },
  {
    question: 'Do I need advanced coding experience to follow along?',
    answer:
      'No. Many guides start with a small, manual task and then automate only one step. You can follow the beginner AI automation and web development tutorials even if you are still learning to code.',
  },
  {
    question: 'How can I deploy a website like this for free?',
    answer:
      'This site is a static Astro blog hosted on Netlify. The GitHub + Netlify tutorial walks through putting a static website online at no cost, including build settings and common beginner mistakes.',
  },
];

const jsonLd = [
  webPageJsonLd({
    type: 'WebPage',
    path: '/',
    name: pageTitle,
    description: pageDescription,
  }),
  breadcrumbJsonLd([{ name: 'Home', path: '/' }]),
  {
    '@type': 'Blog',
    '@id': `${siteConfig.url}/#blog`,
    name: siteConfig.name,
    url: `${siteConfig.url}/blog/`,
    description: pageDescription,
    author: { '@id': `${siteConfig.url}/#person` },
    publisher: { '@id': `${siteConfig.url}/#organization` },
    blogPost: latest.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: `${siteConfig.url}/blog/${post.slug}/`,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  seoTitle={pageTitle}
  description={pageDescription}
  canonical="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="hero-brand">{siteConfig.name}</p>
        <h1 class="hero-title">Building With AI, Code &amp; Automation</h1>
        <p class="hero-desc">
          Tutorials and build notes on AI tools, automation workflows, and practical coding
          projects — written for beginners and developers who want to ship.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog/">Read Articles</a>
          <a class="btn btn-secondary" href="/projects/">View Projects</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Blog highlights">
        <h2>Currently exploring</h2>
        <div class="hero-stats">
          <div class="hero-stat"><span>Focus</span><strong>AI + automation</strong></div>
          <div class="hero-stat"><span>Audience</span><strong>Builders &amp; beginners</strong></div>
          <div class="hero-stat"><span>Articles</span><strong>{posts.length} published</strong></div>
          <div class="hero-stat"><span>Hosting</span><strong>Free on Netlify</strong></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">Latest Articles</p>
        <h2 class="section-title">Fresh notes from the workshop</h2>
        <p class="section-lead">
          Start with AI tools for developers, beginner automation workflows, or free GitHub and
          Netlify deployment.
        </p>
      </div>
      <div class="card-grid cols-3">
        {
          latest.map((post, index) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.slug}/`}
              category={getCategoryName(post.data.category)}
              date={post.data.pubDate}
              readingTime={post.data.readingTime}
              image={post.data.heroImage}
              priority={index === 0}
            />
          ))
        }
      </div>
      <p style="margin-top:1.5rem;">
        <a class="btn btn-secondary" href="/blog/">Browse all articles</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">Featured Projects</p>
        <h2 class="section-title">Things I’m building in public</h2>
        <p class="section-lead">Small, useful experiments that connect AI with everyday developer work.</p>
      </div>
      <div class="card-grid cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p style="margin-top:1.5rem;">
        <a class="btn btn-secondary" href="/projects/">See all projects</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">Categories</p>
        <h2 class="section-title">Find a topic that fits</h2>
        <p class="section-lead">Jump into AI tools, automation, beginner coding guides, and more.</p>
      </div>
      <div class="card-grid cols-3">
        {
          categories.map((category) => (
            <a class="category-card" href={`/categories/${category.slug}/`}>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container about-grid">
      <div>
        <div class="section-head">
          <p class="section-eyebrow">About me</p>
          <h2 class="section-title">Learning in public, one build at a time</h2>
        </div>
        <p style="color:var(--text-muted);margin-top:0;">
          I’m {siteConfig.author}, a builder documenting how AI tools, automation, and solid coding
          fundamentals come together in real projects. This blog is written for beginners,
          students, freelancers, and developers who want practical explanations—not jargon.
        </p>
        <p style="margin-top:1rem;">
          <a class="btn btn-primary" href="/about/">More about me</a>
        </p>
      </div>
      <div class="panel">
        <h3 style="margin-top:0;font-family:var(--font-display);">What you’ll find here</h3>
        <ul style="margin:0;padding-left:1.1rem;color:var(--text-muted);">
          <li>Beginner-friendly programming guides</li>
          <li>AI automation workflows you can recreate</li>
          <li>Developer productivity tips</li>
          <li>No-code / low-code experiments</li>
          <li>Honest notes from my learning journey</li>
        </ul>
        <div class="social-links" style="margin-top:1.2rem;">
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer">X</a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">FAQ</p>
        <h2 class="section-title">Common questions</h2>
        <p class="section-lead">Quick answers before you browse the tutorials.</p>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
