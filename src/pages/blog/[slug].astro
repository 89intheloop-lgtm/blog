---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { siteConfig } from '../../data/site';
import { getCategoryName } from '../../utils/categories';
import { absoluteUrl, breadcrumbJsonLd, readingTimeIso, webPageJsonLd } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

const index = allPosts.findIndex((p) => p.slug === post.slug);
const prev = index > 0 ? allPosts[index - 1] : null;
const next = index < allPosts.length - 1 ? allPosts[index + 1] : null;

const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .filter(
    (p) =>
      p.data.category === post.data.category ||
      p.data.tags.some((tag) => post.data.tags.includes(tag))
  )
  .slice(0, 3);

const canonical = `/blog/${post.slug}/`;
const pageUrl = absoluteUrl(canonical);
const categoryName = getCategoryName(post.data.category);
const formatted = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const imageUrl = post.data.heroImage ? absoluteUrl(post.data.heroImage) : absoluteUrl(siteConfig.defaultOgImage);

const jsonLd = [
  webPageJsonLd({
    path: canonical,
    name: post.data.title,
    description: post.data.description,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: categoryName, path: `/categories/${post.data.category}/` },
    { name: post.data.title, path: canonical },
  ]),
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: {
      '@type': 'ImageObject',
      url: imageUrl,
    },
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      '@id': `${siteConfig.url}/#person`,
      '@type': 'Person',
      name: post.data.author,
      url: absoluteUrl('/about/'),
    },
    publisher: { '@id': `${siteConfig.url}/#organization` },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageUrl,
    },
    isPartOf: { '@id': `${siteConfig.url}/#blog` },
    keywords: post.data.tags.join(', '),
    articleSection: categoryName,
    inLanguage: siteConfig.language,
    wordCount,
    timeRequired: readingTimeIso(post.data.readingTime),
    url: pageUrl,
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  image={post.data.heroImage}
  imageAlt={post.data.title}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article class="container article-layout">
    <aside>
      <TableOfContents headings={headings} />
    </aside>

    <div>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog', href: '/blog/' },
          { label: categoryName, href: `/categories/${post.data.category}/` },
          { label: post.data.title },
        ]}
      />
      <header class="article-hero">
        <div class="meta">
          <a class="pill" href={`/categories/${post.data.category}/`}>
            {categoryName}
          </a>
          <time datetime={post.data.pubDate.toISOString()}>{formatted}</time>
          {post.data.readingTime && <span>{post.data.readingTime}</span>}
          <span>By {post.data.author}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p style="margin:1rem 0 0;color:var(--text-muted);font-size:1.12rem;">{post.data.description}</p>
      </header>

      {
        post.data.heroImage && (
          <div class="article-cover-lg">
            <img
              src={post.data.heroImage}
              alt={`Cover illustration for ${post.data.title}`}
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <ul class="tag-list">
        {
          post.data.tags.map((tag) => (
            <li>
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
            </li>
          ))
        }
      </ul>

      <ShareButtons title={post.data.title} url={pageUrl} />

      <nav class="pager" aria-label="Previous and next articles">
        {
          prev && (
            <a href={`/blog/${prev.slug}/`}>
              <span>Previous</span>
              <strong>{prev.data.title}</strong>
            </a>
          )
        }
        {
          next && (
            <a href={`/blog/${next.slug}/`}>
              <span>Next</span>
              <strong>{next.data.title}</strong>
            </a>
          )
        }
      </nav>

      {
        related.length > 0 && (
          <section style="margin-top:3rem;">
            <div class="section-head">
              <p class="section-eyebrow">Keep reading</p>
              <h2 class="section-title">Related articles</h2>
            </div>
            <div class="card-grid cols-3">
              {related.map((item) => (
                <ArticleCard
                  title={item.data.title}
                  description={item.data.description}
                  href={`/blog/${item.slug}/`}
                  category={getCategoryName(item.data.category)}
                  date={item.data.pubDate}
                  readingTime={item.data.readingTime}
                  image={item.data.heroImage}
                />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
