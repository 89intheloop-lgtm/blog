---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories, siteConfig } from '../../data/site';
import { breadcrumbJsonLd, webPageJsonLd } from '../../utils/seo';

const title = 'Browse Topics: AI Tools, Automation & Coding';
const description =
  'Browse Build Log categories covering AI tools, AI automation, web development, beginner coding guides, developer productivity, and learning-in-public notes.';
const jsonLd = [
  webPageJsonLd({
    type: 'CollectionPage',
    path: '/categories/',
    name: title,
    description,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Categories', path: '/categories/' },
  ]),
];
---

<BaseLayout
  seoTitle={`${title} | ${siteConfig.name}`}
  description={description}
  canonical="/categories/"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Categories' }]} />
      <p class="section-eyebrow">Categories</p>
      <h1>Browse by topic</h1>
      <p>Pick a category to find tutorials and notes that match what you’re learning right now.</p>
    </div>
  </section>

  <section class="section" style="padding-top:1rem;">
    <div class="container card-grid cols-3">
      {
        categories.map((category) => (
          <a class="category-card" href={`/categories/${category.slug}/`}>
            <h2>{category.name}</h2>
            <p>{category.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
