---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../data/site';
import { breadcrumbJsonLd, webPageJsonLd } from '../utils/seo';

const title = `About ${siteConfig.author} — Learning AI, Code & Automation`;
const description = `Meet ${siteConfig.author}, the creator of ${siteConfig.name}. A beginner-friendly blog about AI tools, automation workflows, coding tutorials, and shipping software in public.`;
const jsonLd = [
  webPageJsonLd({
    type: 'AboutPage',
    path: '/about/',
    name: title,
    description,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
  {
    '@type': 'ProfilePage',
    url: `${siteConfig.url}/about/`,
    name: title,
    mainEntity: { '@id': `${siteConfig.url}/#person` },
  },
];
---

<BaseLayout
  seoTitle={`${title} | ${siteConfig.name}`}
  description={description}
  canonical="/about/"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <p class="section-eyebrow">About</p>
      <h1>Hi, I’m {siteConfig.author}</h1>
      <p>
        I write about building with AI, learning to code, and turning ideas into working software —
        especially automation that saves time.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container split-grid">
      <div class="prose">
        <h2>Why this blog exists</h2>
        <p>
          When I started learning AI automation and modern web development, I wanted clear,
          beginner-friendly explanations with real examples. This site is that notebook made
          public.
        </p>
        <p>
          If you are looking for <a href="/blog/">AI and coding tutorials</a>, start with the
          latest articles. For project ideas, see the
          <a href="/projects/">featured AI builds</a>.
        </p>
        <h2>Who it’s for</h2>
        <ul>
          <li>Beginners learning to code</li>
          <li>Developers exploring AI tools</li>
          <li>Students building portfolio projects</li>
          <li>Freelancers looking for productivity workflows</li>
          <li>Anyone curious about no-code / low-code automation</li>
        </ul>
        <h2>What I focus on</h2>
        <p>
          AI tools and tutorials, AI-powered apps, developer productivity, practical coding
          projects, and honest notes from experiments that succeed (and ones that don’t).
        </p>
        <h2>Let’s connect</h2>
        <p>
          Have a question, collaboration idea, or topic request?
          <a href="/contact/">Send me a message</a>.
        </p>
      </div>
      <aside class="panel">
        <h2 style="margin-top:0;font-family:var(--font-display);font-size:1.4rem;">Quick facts</h2>
        <ul style="margin:0;padding-left:1.1rem;color:var(--text-muted);">
          <li>Building in public</li>
          <li>Static site on Netlify</li>
          <li>Markdown-powered articles</li>
          <li>Beginner-first explanations</li>
        </ul>
        <div class="social-links" style="margin-top:1.25rem;">
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer">X</a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
