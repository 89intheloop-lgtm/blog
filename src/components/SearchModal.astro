---
import { getCollection } from 'astro:content';
import { getCategoryName } from '../utils/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  url: `/blog/${post.slug}/`,
  category: getCategoryName(post.data.category),
  tags: post.data.tags,
}));
---

<div class="search-overlay" data-search-overlay hidden>
  <div
    class="search-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-title"
  >
    <h2 id="search-title" class="sr-only">Search articles</h2>
    <label class="sr-only" for="site-search">Search blog posts</label>
    <input
      id="site-search"
      type="search"
      placeholder="Search articles, topics, or tags…"
      data-search-input
      autocomplete="off"
    />
    <ul class="search-results" data-search-results></ul>
    <p class="search-empty" data-search-empty>Start typing to find an article.</p>
  </div>
</div>

<script id="search-index" type="application/json" set:html={JSON.stringify(posts)} />
